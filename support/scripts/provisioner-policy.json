{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:listBucket"
            ],
            "Resource": [
                "arn:aws:s3:::event-logger-terraform-state",
                "arn:aws:s3:::event-logger-terraform-state/env/dev/*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:DeleteItem"
            ],
            "Resource": "arn:aws:dynamodb:ap-southeast-1:297416720645:table/event-logger-terraform-state-locks"
        },
        {
            "Effect": "Allow",
            "Action": [
                "dynamodb:CreateTable",
                "dynamodb:TagResource"
            ],
            "Resource": "arn:aws:dynamodb:ap-southeast-1:297416720645:table/*",
            "Condition": {
                "StringLike": {
                    "aws:RequestTag/environment": ["dev"]
                }
            }
        },
        {
            "Effect": "Allow",
            "Action": [
                "dynamodb:DeleteTable"
            ],
            "Resource": "arn:aws:dynamodb:ap-southeast-1:297416720645:table/*",
            "Condition": {
                "StringLike": {
                    "aws:ResourceTag/environment": ["dev"]
                }
            }
        },
        {
            "Effect": "Allow",
            "Action": [
                "dynamodb:Describe*",
                "dynamodb:ListTagsOfResource"
            ],
            "Resource": "arn:aws:dynamodb:ap-southeast-1:297416720645:table/*"
        },
        {
            "Effect": "Allow",
            "Action": [
                "ecr:CreateRepository",
                "ecr:TagResource"
            ],
            "Resource": "arn:aws:ecr:ap-southeast-1:297416720645:repository/*",
            "Condition": {
                "StringLike": {
                    "aws:RequestTag/environment": ["dev"]
                }
            }
        },
        {
            "Effect": "Allow",
            "Action": [
                "ecr:DeleteRepository",
                "ecr:DeleteLifecyclePolicy",
                "ecr:PutLifecyclePolicy"
            ],
            "Resource": "arn:aws:ecr:ap-southeast-1:297416720645:repository/*",
            "Condition": {
                "StringLike": {
                    "aws:ResourceTag/environment": ["dev"]
                }
            }
        },
        {
            "Effect": "Allow",
            "Action": [
                "ecr:Describe*",
                "ecr:Get*",
                "ecr:ListTagsForResource"
            ],
            "Resource": "arn:aws:ecr:ap-southeast-1:297416720645:repository/*"
        }
    ]
}